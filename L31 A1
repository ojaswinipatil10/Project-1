<html>
<head>
    <script>
        function validateForms() {
            var x = document.forms["myForm"]["fname"].value;
            if (x== "") {
                alert("Name must be filed out") ;
                return false;
            }
        }
        </script>
        </head>
        <body>
            <form name="myForm" onsubmit="return validateForms()">
                Name: <input type="text" name="fname">
                <input type="submit" value="Submit">
                </form>
                <p id="message"></p>
                </body>
                </html>