<html>
    <body style="background-color: rgb(213, 188, 192); font-family: Times New Roman;">

        <h2>JS While Loop</h2>
        <p id ="number"></p>
        <script>
            var text = "";
            var i = 0;
            while (i <100) {
                text+= "<br> The number is" +i;
                i++;
            }
           document.getElementById("number").innerHTML = text;
            </script>
    </body>
</html>
