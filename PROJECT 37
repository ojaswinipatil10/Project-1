<html>
<head>
    <title>Expense Tracker</title>
    <link rel="stylesheet" href="PROJECT 37.css">
</head>
<body>

<div class="container">

    <h1>💳 Expense Tracker</h1>
    <p>Welcome, Heera!</p>

    <div class="balance-card">
        <h2>Total Balance</h2>
        <h1>$2,450</h1>
    </div>

    <div class="cards">

        <div class="card income">
            <h3>Income</h3>
            <p>$3,500</p>
        </div>

        <div class="card expense">
            <h3>Expense</h3>
            <p>$1,050</p>
        </div>

    </div>

    <div class="form-box">
        <h2>Add Expense</h2>

        <input type="text" placeholder="Expense Name">

        <input type="number" placeholder="Amount">

        <button>Add</button>
    </div>

    <div class="transactions">

        <h2>Recent Transactions</h2>

        <ul>
            <li>🍔 Food <span>-$20</span></li>
            <li>🛍 Shopping <span>-$60</span></li>
            <li>💰 Salary <span class="green">+$500</span></li>
            <li>🚖 Taxi <span>-$15</span></li>
        </ul>

    </div>

</div>

</body>
</html>