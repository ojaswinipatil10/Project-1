<html>
<head>
    <title>
        Animation Time!!
    </title>
    <style>

        @keyframes Slide {
    0%  {background-color: rgb(217, 124, 124); }
    25%  {background-color: rgb(128, 199, 128); }   
    50%  {background-color: rgb(143, 114, 210);}  
    100% {background-color: rgb(136, 122, 70);}
        }
div {
    width: 90px;
    height: 120px;
    background-color: rgb(154, 194, 230);
    animation-name: Slide;
    animation-duration: 6s;
}
</style>
</head>
<body>
    <div>
        Namaste
    </div>
</body>
</html>
