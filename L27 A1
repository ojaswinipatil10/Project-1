<html>
<head>
    JS ARRAY SORT
</head>
<body>

    <h2>JS ARRAY SORT</h2>

    <p>Click the button to sort the arry in ascending order .</p>

    <button onclick="ascending()">Ascending order</button>
     <button onclick="descending()">Descending order</button>

     <p id="result"></p>

     <script>
        
     var points =[40 , 90 , 56 , 300 , 23];

     document.getElementById("result").innerHTML = points;

     function ascending() {
        points.sort(function(a , b) {
            return a - b;
        });
     document.getElementById("result").innerHTML = points;
    }

      function descending() {
        points.sort(function(a , b) {
            return b - a;
        });
     document.getElementById("result").innerHTML = points;
      }

    </script>
    </body>
</html>