<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Susan's Kitchen</title>
    <style>
        /* Color Palette & Reset */
        :root {
            --primary-coral: #10276c;
            --sunny-yellow: #FFD93D;
            --deep-orange: #FF8E53;
            --soft-cream: #FFF9F0;
            --dark-text: #2D3436;
        }

        body {
            margin: 0;
            padding: 0;
            font-family: 'Poppins', sans-serif;
            background-color: var(--soft-cream);
        }

        /* 1. Navigation Bar */
        nav {
            background-color: white;
            display: flex;
            justify-content: space-between;
            align-items: center;
            padding: 1rem 5%;
            box-shadow: 0 4px 15px rgba(0,0,0,0.05);
            position: sticky;
            top: 0;
            z-index: 1000;
        }

        .logo {
            font-size: 1.5rem;
            font-weight: 800;
            color: var(--primary-coral);
            text-transform: uppercase;
            letter-spacing: 1px;
        }

        .nav-links {
            list-style: none;
            display: flex;
            gap: 2rem;
            margin: 0;
        }

        .nav-links a {
            text-decoration: none;
            color: var(--dark-text);
            font-weight: 500;
            transition: color 0.3s;
        }

        .nav-links a:hover {
            color: var(--primary-coral);
        }

        .cta-button {
            background: linear-gradient(45deg, var(--primary-coral), var(--deep-orange));
            color: white;
            padding: 10px 25px;
            border-radius: 50px;
            text-decoration: none;
            font-weight: bold;
            box-shadow: 0 4px 15px rgba(255, 107, 107, 0.3);
        }

        /* 2. Banner / Hero Section */
        .banner {
            height: 80vh;
            background: linear-gradient(rgba(0,0,0,0.4), rgba(0,0,0,0.4)), 
                        url('https://images.unsplash.com/photo-1504674900247-0877df9cc836?auto=format&fit=crop&w=1500&q=80');
            background-size: cover;
            background-position: center;
            display: flex;
            flex-direction: column;
            justify-content: center;
            align-items: center;
            text-align: center;
            color: white;
            padding: 0 20px;
        }

        .banner h1 {
            font-size: 4rem;
            margin-bottom: 10px;
            text-shadow: 2px 2px 10px rgba(0,0,0,0.3);
        }

        .banner p {
            font-size: 1.2rem;
            margin-bottom: 30px;
            max-width: 600px;
        }

        .banner-btn {
            background-color: var(--sunny-yellow);
            color: var(--dark-text);
            padding: 15px 40px;
            border-radius: 5px;
            text-decoration: none;
            font-weight: bold;
            font-size: 1.1rem;
            transition: transform 0.2s;
        }

        .banner-btn:hover {
            transform: scale(1.05);
            background-color: #f7ca18;
        }
    </style>
</head>
<body>

    <nav>
        <div class="logo">Susan's Kitchen</div>
        <ul class="nav-links">
            <li><a href="#">Home</a></li>
            <li><a href="#">Menu</a></li>
            <li><a href="#">About</a></li>
            <li><a href="#">Contact</a></li>
        </ul>
        <a href="#" class="cta-button">Order Now</a>
    </nav>

    <header class="banner">
        <h1>Deliciously Fresh</h1>
        <p>Experience the finest organic ingredients served with love and a splash of color.</p>
        <a href="#" class="banner-btn">View Menu</a>
    </header>

</body>
</html>