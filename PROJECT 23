<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width">
  <title>Flower Shop</title>
  <style>
    /* Adding just a little color with simple CSS */
    body { background-color: #fff0f5; font-family: sans-serif; }
    fieldset { background-color: white; border: 2px solid pink; }
    legend { color: #d02090; }
    label { color: #556b2f; }
  </style>
</head>

<body>
  <fieldset>
    <legend><b>🌸 Flower Order Form</b></legend>
    <form oninput="x.value=(parseInt(q1.value)||0)+(parseInt(q2.value)||0)+(parseInt(q3.value)||0)">
      
      <label>Customer Name</label><br>
      <input type="text" id="name"><br><br>
      
      <label>Select Flowers</label><br>
      
      <select id="s1">
        <option>Roses</option>
        <option>Tulips</option>
      </select>
      <input type="number" id="q1"><br><br>
      
      <select id="s2">
        <option>Sunflowers</option>
        <option>Daisies</option>
      </select>
      <input type="number" id="q2"><br><br>
      
      <select id="s3">
        <option>Lilies</option>
        <option>Orchids</option>
      </select>
      <input type="number" id="q3"><br><br>
      
      <b>Total Stems:</b> <output name="x">0</output>
    </form>
  </fieldset>
</body>