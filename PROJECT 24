<html>
<head>
    <title>JS Math Object</title>
</head>

<body style="background-color:#c0ccdb; font-family: Arial;">

    <h2 style="color:#165d69; text-align:center;">
        JavaScript Math Object
    </h2>

    <p style="color:#660066; font-size:18px; font-family: 'Franklin Gothic Medium', 'Arial Narrow', Arial, sans-serif;">

        <script type="text/javascript">
            var value = Math.abs(-80);
            document.write("Demo Test Value : " + value + "<br>");

            var value = Math.acos(-1);
            document.write("Demo Test Value : " + value + "<br>");

            var value = Math.asin(4);
            document.write("Demo Test Value : " + value + "<br>");

            var value = Math.atan(0.9);
            document.write("Demo Test Value : " + value + "<br>");

            var value = Math.ceil(20.78);
            document.write("Demo Test Value : " + value + "<br>");
        </script>

    </p>

</body>
</html>
