
<html>
<head>
    <title>Bank Expense Tracker</title>
    <link rel="stylesheet" href="PROJECT 39.css">
</head>
<body>

<div class="container">
    <h2>Bank Expense Tracker</h2>

    <form onsubmit="return validateForm()">

        <label>Name</label>
        <input type="text" id="name">

        <label>Income</label>
        <input type="number" id="income">

        <label>Expense</label>
        <input type="number" id="expense">

        <label>Category</label>
        <select id="category">
            <option value="">Select</option>
            <option>Food</option>
            <option>Travel</option>
            <option>Shopping</option>
            <option>Bills</option>
        </select>

        <button type="submit">Submit</button>

    </form>

    <p id="error"></p>
</div>

<script src="script.js"></script>

</body>
</html>