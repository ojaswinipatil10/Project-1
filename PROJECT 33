<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Chic Login Portal</title>
    <style>
        /* Modern aesthetic with Butter Yellow palette */
        :root {
            --butter-light: #FFF9E3;
            --butter-main: #FDF1B8;
            --butter-deep: #F9E076;
            --text-color: #5D5329;
        }

        body {
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            background-color: var(--butter-light);
            display: flex;
            justify-content: center;
            align-items: center;
            height: 100vh;
            margin: 0;
            color: var(--text-color);
        }

        .login-card {
            background: white;
            padding: 2.5rem;
            border-radius: 20px;
            box-shadow: 0 10px 25px rgba(249, 224, 118, 0.3);
            width: 350px;
            border: 2px solid var(--butter-main);
        }

        h2 {
            text-align: center;
            margin-bottom: 1.5rem;
            font-weight: 600;
        }

        .input-group {
            margin-bottom: 1.2rem;
        }

        label {
            display: block;
            margin-bottom: 0.5rem;
            font-size: 0.9rem;
            font-weight: bold;
        }

        input {
            width: 100%;
            padding: 12px;
            border: 2px solid var(--butter-light);
            border-radius: 10px;
            box-sizing: border-box;
            outline: none;
            transition: border-color 0.3s;
            background-color: #FFFEFA;
        }

        input:focus {
            border-color: var(--butter-deep);
        }

        button {
            width: 100%;
            padding: 12px;
            background-color: var(--butter-main);
            border: none;
            border-radius: 10px;
            color: var(--text-color);
            font-weight: bold;
            font-size: 1rem;
            cursor: pointer;
            transition: background 0.3s, transform 0.2s;
            margin-top: 1rem;
        }

        button:hover {
            background-color: var(--butter-deep);
            transform: translateY(-2px);
        }
    </style>
</head>
<body>

<div class="login-card">
    <h2>Welcome Back</h2>
    
    <div class="input-group">
        <label for="userName">Full Name</label>
        <input type="text" id="userName" placeholder="Enter your name">
    </div>

    <div class="input-group">
        <label for="userAge">Age</label>
        <input type="number" id="userAge" placeholder="Must be 18 or older">
    </div>

    <button onclick="validateForm()">Sign In</button>
</div>

<script>
    function validateForm() {
        // 1. Get the values from the inputs
        const name = document.getElementById('userName').value.trim();
        const age = document.getElementById('userAge').value;

        if (name === "") {
            alert("Oops! Please enter your name to continue.");
            return;
        }

    
        if (age === "") {
            alert("Please enter your age.");
            return;
        }

        if (age < 18) {
            alert("Access Denied: You must be at least 18 years old.");
            return;
        }

        alert("Success! Welcome, " + name + ".");
    }
</script>

</body>
</html>