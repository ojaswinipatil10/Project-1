            box-shadow: 2px 25px color(srgb rgb(220, 179, 179) green blue);
        }
        .profile {
            background-color: aliceblue;
            color: black;
            text-align: right;
        }
        .profile.img {
            width: 30px;
            border-radius: 15%px;
